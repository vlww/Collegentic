# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Required for the frontend dev server (Vite, :5173) to make POST/PUT/DELETE
# requests through its proxy to this backend (:8000) — without this, ADK's
# built-in origin-check middleware returns 403 on every non-GET request
# from the browser (curl-based testing won't catch this: curl doesn't send
# an Origin header, so the check never triggers).
ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
