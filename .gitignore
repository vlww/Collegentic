# Node / frontend
**/node_modules
frontend/dist
npm-debug.log*

# Frontend build copied into the Cloud Run image for Milestone 17's
# bundled deploy (agent/scripts/build_frontend.sh) — regenerated, not
# committed, same as frontend/dist above. The directory itself (via
# .gitkeep) stays tracked so `COPY ./frontend_dist` in the Dockerfile has
# something to copy even before the build script has ever run.
agent/frontend_dist/*
!agent/frontend_dist/.gitkeep

# Python / agent (agent/ also has its own, kept for defense in depth)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Regenerable eval output (agents-cli eval generate/grade,
# tests/eval/capture_traces.py) — the reusable input dataset lives in
# agent/tests/eval/datasets/ instead, which IS committed.
agent/artifacts/

# Environments — never commit secrets
.env
.env.local
!.env.example

# Editors / OS
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
